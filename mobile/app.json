{
  "expo": {
    "name": "1top",
    "slug": "onetop",
    "version": "4.3.0",
    "scheme": "onetop",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "si.onetop.mobile",
      "buildNumber": "9",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "2DY8KQ6H5F"
    },
    "android": {
      "package": "si.onetop.mobile",
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0d1218"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/IBMPlexSansKR-Regular.ttf",
            "./assets/fonts/IBMPlexSansKR-Medium.ttf",
            "./assets/fonts/IBMPlexSansKR-SemiBold.ttf",
            "./assets/fonts/IBMPlexSansKR-Bold.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "1top uses the photos you choose to send them to your own AI session.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "website": "https://1top.si"
    }
  }
}
